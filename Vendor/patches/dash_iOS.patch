+#if TARGET_OS_IPHONE
+/*
+ * iOS: commands are threads (ios_system), and each takes its standard streams from one-shot ios_dup2 calls, closing
+ * them when it ends. So dash keeps what 0, 1, and 2 are redirected to (by redirections and pipelines; -1: not
+ * redirected) and gives every command it starts its own copies (ios_applyredirections). A redirection then covers
+ * every command of a compound command or function, not only the first, and loops reading a redirected input keep
+ * reading where the last command stopped.
+ */
+int ios_redirected[3] = { -1, -1, -1 };
+/* The copy of a redirected standard input that ios_applyredirections last gave a command (-1: none). */
+int ios_lastinputcopy = -1;
+
+STATIC int ios_threadfd(int fd)
+{
+	FILE *stream = fd == 0 ? thread_stdin : fd == 1 ? thread_stdout : thread_stderr;
+	return stream != NULL ? fileno(stream) : fd;
+}
+
+void ios_applyredirections(void)
+{
+	int fd;
+
+	ios_lastinputcopy = -1;
+	for (fd = 0; fd < 3; fd++)
+		if (ios_redirected[fd] >= 0) {
+			int copy = dup(ios_redirected[fd]);
+			if (copy >= 0) {
+				ios_dup2(copy, fd);
+				if (fd == 0)
+					ios_lastinputcopy = copy;
+			}
+		}
+}
+
+/* Redirects standard stream fd to f, which openredirect opened (or, for >&n and <&n, the descriptor to copy). */
+STATIC void ios_redirect(union node *redir, int fd, int f)
+{
+	int target;
+
+	if (redir->nfile.type == NTOFD || redir->nfile.type == NFROMFD) {
+		if (f < 0)	/* >&- */
+			target = open("/dev/null", O_RDWR);
+		else
+			target = dup(f <= 2 ? (ios_redirected[f] >= 0 ? ios_redirected[f] : ios_threadfd(f)) : f);
+	} else
+		target = f;
+	ios_redirected[fd] = target;
+}
+#endif
