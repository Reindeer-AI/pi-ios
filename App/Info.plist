			<key>LSItemContentTypes</key>
			<array>
				<string>dev.pimobile.extension</string>
				<string>dev.pimobile.session</string>
			</array>
		</dict>
	</array>
	<key>LSSupportsOpeningDocumentsInPlace</key>
