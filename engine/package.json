    "@earendil-works/pi-durable": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@noble/hashes": "1.8.0",
    "buffer": "6.0.3",
    "es-module-lexer": "3.0.3",
    "esbuild-wasm": "0.28.2",
    "events": "3.3.0",
    "marked": "18.0.11",
    "path-browserify": "1.0.1",
    "semver": "7.8.5",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/path-browserify": "1.0.3",
